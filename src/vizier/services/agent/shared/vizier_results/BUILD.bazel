load("//bazel:pl_build_system.bzl", "pl_cc_library", "pl_cc_test")

package(default_visibility = ["//src/experimental/standalone_pem:__pkg__"])

pl_cc_library(
    name = "cc_library",
    srcs = ["result_conversion.cc"],
    hdrs = ["result_conversion.h"],
    deps = [
        "//src/api/proto/vizierpb:vizier_pl_cc_proto",
        "//src/carnot/carnotpb:carnot_pl_cc_proto",
        "//src/carnot/planpb:plan_pl_cc_proto",
        "//src/shared/types/typespb/wrapper:cc_library",
        "//src/table_store/schemapb:schema_pl_cc_proto",
        "@com_github_grpc_grpc//:grpc++",
    ],
)

pl_cc_test(
    name = "result_conversion_test",
    srcs = ["result_conversion_test.cc"],
    deps = [":cc_library"],
)
