load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@io_bazel_rules_docker//cc:image.bzl", "cc_image")
load("@io_bazel_rules_docker//container:container.bzl", "container_image")
load("//bazel:pl_build_system.bzl", "pl_cc_binary", "pl_cc_library", "pl_cc_test")

package(default_visibility = ["//src/vizier:__subpackages__"])

# Compile-time kill switch for the direct-query endpoint. Defaults to True, so
# the feature is compiled in and gated at runtime by --direct_query_enabled
# (itself false by default). Operators who do not want the feature present in
# the binary at all build with
# `bazel build … --//src/vizier/services/agent/pem:direct_query=false`, which
# puts `-DPX_PEM_DIRECT_QUERY_DISABLED` on this package's compilations only:
# the feature body in direct_query_server.cc and pem_manager.cc is `#ifndef`'d
# out and stub methods return UNIMPLEMENTED. See DIRECT_QUERY_SECURITY.md.
#
# A build setting rather than `--define`: `--define` lives in the global
# configuration key, so it applies to every target in the build and shows up in
# every dependency's configuration; this flag is scoped to the targets that
# read it.
bool_flag(
    name = "direct_query",
    build_setting_default = True,
)

config_setting(
    name = "direct_query_disabled",
    flag_values = {":direct_query": "False"},
)

pl_cc_library(
    name = "cc_library",
    srcs = glob(
        ["*.cc"],
        exclude = [
            "**/*_test.cc",
            "*_main.cc",
        ],
    ),
    hdrs = glob(["*.h"]),
    # local_defines, not defines: the macro only guards this package's sources,
    # so there is no reason to push it onto every transitive dependent's
    # compilation. Targets that need to compile against the disabled build
    # (direct_query_server_test below) select on the same config_setting.
    local_defines = select({
        ":direct_query_disabled": ["PX_PEM_DIRECT_QUERY_DISABLED"],
        "//conditions:default": [],
    }),
    deps = [
        # direct-query server deps (direct_query_server.{h,cc}):
        "//src/api/proto/vizierpb:vizier_pl_cc_proto",
        "//src/carnot",
        "//src/carnot:cc_library",
        "//src/carnot/carnotpb:carnot_pl_cc_proto",
        "//src/carnot/exec:cc_library",
        "//src/carnot/funcs:cc_library",
        "//src/carnot/planner/compiler:cc_library",
        "//src/carnot/planpb:plan_pl_cc_proto",
        "//src/carnot/udf:cc_library",
        # HS256 verify uses BoringSSL HMAC directly and parses claims via rapidjson.
        "@boringssl//:crypto",
        "@com_github_arun11299_cpp_jwt//:cpp_jwt",
        "@com_github_grpc_grpc//:grpc++",
        "@com_github_rlyeh_sole//:sole",
        "@com_github_tencent_rapidjson//:rapidjson",
        # existing PEM deps:
        "//src/carnot/planner/dynamic_tracing/ir/logicalpb:logical_pl_cc_proto",
        "//src/integrations/grpc_clocksync:cc_library",
        "//src/shared/tracepoint_translation:cc_library",
        "//src/stirling:cc_library",
        "//src/stirling/source_connectors/dynamic_tracer/dynamic_tracing/ir/logicalpb:logical_pl_cc_proto",
        "//src/vizier/services/agent/shared/manager:cc_library",
    ],
)

pl_cc_test(
    name = "tracepoint_manager_test",
    srcs = ["tracepoint_manager_test.cc"],
    deps = [
        ":cc_library",
        "//src/common/testing/event:cc_library",
        "//src/stirling/testing:stirling_mock",
        "//src/vizier/services/agent/shared/manager:test_utils",
    ],
)

# TDD contract for the PEM direct-query endpoint.
# See DIRECT_QUERY_CONTRACT.md for the behavioral spec.
pl_cc_test(
    name = "direct_query_server_test",
    srcs = ["direct_query_server_test.cc"],
    # The kill-switch assertions are `#ifdef PX_PEM_DIRECT_QUERY_DISABLED`, and
    # cc_library's local_defines deliberately do not reach here — so select on
    # the flag again, otherwise a `--//…:direct_query=false` run would silently
    # compile the enabled branch and skip the coverage entirely.
    defines = select({
        ":direct_query_disabled": ["PX_PEM_DIRECT_QUERY_DISABLED"],
        "//conditions:default": [],
    }),
    deps = [
        ":cc_library",
        "//src/api/proto/vizierpb:vizier_pl_cc_proto",
        "//src/carnot",
        "//src/carnot:cc_library",
        "//src/carnot/exec:cc_library",
        "//src/carnot/funcs:cc_library",
        "//src/carnot/udf:cc_library",
        "//src/table_store:cc_library",
        "@com_github_arun11299_cpp_jwt//:cpp_jwt",
        "@com_github_grpc_grpc//:grpc++",
        "@com_github_rlyeh_sole//:sole",
    ],
)

pl_cc_binary(
    name = "pem",
    srcs = ["pem_main.cc"],
    stamp = -1,
    deps = [
        ":cc_library",
        "//src/common/signal:cc_library",
        "//src/common/system:cc_library",
        "//src/shared/version:cc_library",
        "//src/shared/version:version_linkstamp",
        "//src/vizier/services/agent/shared/base:cc_library",
    ],
)

container_image(
    name = "pem_base_image",
    base = "//:pl_cc_base_image",
    layers = ["//src/stirling:bpf_layer"],
)

cc_image(
    name = "pem_image",
    base = ":pem_base_image",
    binary = ":pem",
    visibility = [
        "//k8s:__subpackages__",
        "//src/vizier:__subpackages__",
    ],
)
